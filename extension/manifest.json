{
  "manifest_version": 3,
  "name": "NearbyShare",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "activeTab",
    "clipboardWrite",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://192.168.*.*/*",
    "http://10.*.*.*/*",
    "http://172.16.*.*/*",
    "http://172.17.*.*/*",
    "http://172.18.*.*/*",
    "http://172.19.*.*/*",
    "http://172.20.*.*/*",
    "http://172.21.*.*/*",
    "http://172.22.*.*/*",
    "http://172.23.*.*/*",
    "http://172.24.*.*/*",
    "http://172.25.*.*/*",
    "http://172.26.*.*/*",
    "http://172.27.*.*/*",
    "http://172.28.*.*/*",
    "http://172.29.*.*/*",
    "http://172.30.*.*/*",
    "http://172.31.*.*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_cmdOpenPanel__"
    }
  }
}
